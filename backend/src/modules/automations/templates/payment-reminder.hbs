<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{assunto}}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08);">

            <!-- Faixa de topo: a cor já diz se é aviso ou atraso -->
            <tr>
              <td style="background:{{#if emAtraso}}#dc2626{{else}}#4f46e5{{/if}};padding:20px 24px;">
                <p style="margin:0;color:#ffffff;font-size:18px;font-weight:700;">
                  {{#if emAtraso}}⚠️ Conta em atraso{{else}}🔔 Conta a vencer{{/if}}
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:24px;">
                <p style="margin:0 0 16px;font-size:15px;line-height:1.5;">
                  Olá, {{nomeResponsavel}}.
                </p>

                <p style="margin:0 0 20px;font-size:15px;line-height:1.5;">
                  {{#if emAtraso}}
                    A conta abaixo <strong>venceu há {{diasEmAtraso}} {{#if umDiaEmAtraso}}dia{{else}}dias{{/if}}</strong> e ainda não está marcada como paga.
                  {{else}}
                    {{#if venceHoje}}
                      A conta abaixo <strong>vence hoje</strong>.
                    {{else}}
                      A conta abaixo vence em <strong>{{diasAteVencer}} {{#if umDiaAteVencer}}dia{{else}}dias{{/if}}</strong>.
                    {{/if}}
                  {{/if}}
                </p>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fafafa;border:1px solid #e4e4e7;border-radius:8px;">
                  <tr>
                    <td style="padding:16px 18px;">
                      <p style="margin:0 0 10px;font-size:17px;font-weight:700;">{{descricao}}</p>
                      <p style="margin:0 0 6px;font-size:14px;color:#52525b;">
                        Valor: <strong style="color:#18181b;">{{valor}}</strong>
                      </p>
                      <p style="margin:0 0 6px;font-size:14px;color:#52525b;">
                        Vencimento: <strong style="color:{{#if emAtraso}}#dc2626{{else}}#18181b{{/if}};">{{vencimento}}</strong>
                      </p>
                      {{#if categoria}}
                        <p style="margin:0 0 6px;font-size:14px;color:#52525b;">Categoria: {{categoria}}</p>
                      {{/if}}
                      <p style="margin:0;font-size:14px;color:#52525b;">
                        Responsável: {{responsavel}}
                      </p>
                    </td>
                  </tr>
                </table>

                {{#if urlPainel}}
                  <p style="margin:22px 0 0;">
                    <a href="{{urlPainel}}"
                       style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;padding:11px 20px;border-radius:8px;font-size:14px;font-weight:600;">
                      Marcar como paga
                    </a>
                  </p>
                {{/if}}

                <p style="margin:22px 0 0;font-size:13px;line-height:1.5;color:#71717a;">
                  Você vai continuar recebendo este aviso {{frequencia}} até
                  marcar a conta como paga no sistema.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:14px 24px;background:#fafafa;border-top:1px solid #e4e4e7;">
                <p style="margin:0;font-size:12px;color:#a1a1aa;">
                  Enviado automaticamente pelo Controle Financeiro da Casa.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
