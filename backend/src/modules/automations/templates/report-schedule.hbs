<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: Arial, sans-serif; color: #333; }
        .container { max-width: 600px; margin: 0 auto; padding: 20px; }
        .header { background-color: #2c3e50; color: white; padding: 20px; border-radius: 5px; }
        .content { padding: 20px; border: 1px solid #ddd; margin-top: 20px; }
        .footer { text-align: center; padding: 20px; color: #999; font-size: 12px; }
        .button { display: inline-block; background-color: #3498db; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin: 10px 0; }
        .stat { background-color: #ecf0f1; padding: 15px; margin: 10px 0; border-left: 4px solid #3498db; }
        .stat-label { font-weight: bold; color: #2c3e50; }
        .stat-value { font-size: 24px; color: #3498db; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>{{reportName}}</h1>
            <p>Período: {{startDate}} a {{endDate}}</p>
        </div>

        <div class="content">
            <h2>Relatório de Finanças</h2>
            <p>Olá {{userName}},</p>
            <p>Seu relatório automático está pronto!</p>

            {{#if includeSummary}}
            <div class="stat">
                <div class="stat-label">Resumo</div>
                <p>Receita total: <strong>R$ {{totalIncome}}</strong></p>
                <p>Despesa total: <strong>R$ {{totalExpense}}</strong></p>
                <p>Saldo: <strong style="color: {{saldoColor}}">R$ {{balance}}</strong></p>
            </div>
            {{/if}}

            {{#if includeSpendingPatterns}}
            <div class="stat">
                <div class="stat-label">Categoria com Maior Gasto</div>
                <div class="stat-value">{{topCategory}}</div>
                <p>Valor: R$ {{topCategoryAmount}}</p>
            </div>
            {{/if}}

            {{#if includeForecasting}}
            <div class="stat">
                <div class="stat-label">Saldo Previsto (30 dias)</div>
                <div class="stat-value">R$ {{forecastedBalance}}</div>
            </div>
            {{/if}}

            <p style="margin-top: 30px;">
                <a href="{{viewLink}}" class="button">Ver Relatório Completo</a>
            </p>
        </div>

        <div class="footer">
            <p>Casa Financeira - Seu controle financeiro automático</p>
            <p><a href="{{unsubscribeLink}}">Cancelar inscrição</a></p>
        </div>
    </div>
</body>
</html>
