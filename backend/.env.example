# ENVIRONMENT
NODE_ENV=development

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casa_financeira
DB_USER=admin
DB_PASSWORD=admin_dev_password

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=troque_por_uma_chave_aleatoria_de_no_minimo_32_caracteres
JWT_EXPIRATION=7d

# API
API_PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# EMAIL (Configurar com seu SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua_senha_app
EMAIL_FROM=noreply@casafinanceira.com

# PDF Processing
PDF_MAX_SIZE=10485760

# AI/ML
ENABLE_ML_CATEGORIZATION=true
ML_CONFIDENCE_THRESHOLD=0.7

# Monitoring
# SENTRY_DSN=

# Features
ENABLE_DARK_MODE=true
ENABLE_OPEN_FINANCE=false
